  {
    "id": "6a8a1b38431d9349",
    "type": "function",
    "z": "93b1832550c85d6a",
    "g": "b248bc8e4fb8d708",
    "name": "Voyants",
    "func": "// Voyants : transforme chaque message en un texte court pour le dashboard\n// Sorties : 1 ESP32 | 2 Moteur | 3 Buzzer | 4 Capteur température | 5 Capteur vibration\nconst t = msg.topic || \"\";\nconst p = msg.payload;\nconst sorties = [null, null, null, null, null];\n\n// Les messages d'état doivent être des objets JSON\nif (typeof p !== \"object\" || p === null) {\n    node.warn(\"État ignoré (pas un objet JSON) : \" + t);\n    return null;\n}\n\nif (t.endsWith(\"pompe1/etat\")) {                       // Last Will / en ligne\n    sorties[0] = { payload: p.etat === \"en_ligne\" ? \"🟢 En ligne\" : \"🔴 Hors ligne\" };\n}\nelse if (t.endsWith(\"relais/etat\")) {                  // moteur\n    sorties[1] = {\n        payload: p.etat === \"marche\"\n            ? \"🟢 Marche\"\n            : \"🔴 Coupé (\" + (p.cause || \"cause inconnue\") + \")\"\n    };\n}\nelse if (t.endsWith(\"buzzer/etat\")) {                  // buzzer\n    sorties[2] = { payload: p.etat === \"ON\" ? \"🔊 ON\" : \"🔇 OFF\" };\n}\nelse if (msg.grandeur === \"temperature\") {             // vient de Valider mesure\n    sorties[3] = { payload: msg.capteurOk ? \"🟢 OK\" : \"🟠 Capteur en défaut\" };\n}\nelse if (msg.grandeur === \"vibration\") {\n    sorties[4] = { payload: msg.capteurOk ? \"🟢 OK\" : \"🟠 Capteur en défaut\" };\n}\nelse {\n    return null;      // commande, alertes : on s'en occupera au 10.8 et au 10.9\n}\nreturn sorties;",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
