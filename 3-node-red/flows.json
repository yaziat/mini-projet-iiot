  {
    "id": "c3f53f308564fa45",
    "type": "function",
    "z": "93b1832550c85d6a",
    "g": "65fb4453e7a021bf",
    "name": "Ligne CSV",
    "func": "// Ligne CSV : transforme une mesure validée en une ligne de texte\nconst p = msg.payload;\nconst valeur = (p.valeur === null || p.valeur === undefined) ? \"\" : p.valeur;   // capteur en défaut : case vide\n\nmsg.payload = [p.ts, msg.grandeur, valeur, p.unite, p.qualite].join(\",\");\nreturn msg;",
