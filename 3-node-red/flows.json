  {
    "id": "a8a011248c26a3f6",
    "type": "function",
    "z": "93b1832550c85d6a",
    "g": "4c5e4fdc937e1448",
    "name": "Commande manuelle",
    "func": "// Commande manuelle : transforme \"ON\" / \"OFF\" en message de commande JSON\nconst cmd = msg.payload;\n\nif (cmd !== \"ON\" && cmd !== \"OFF\") {          // sécurité : on n'envoie que ON ou OFF\n    node.warn(\"Commande refusée : \" + cmd);\n    return null;\n}\n\nmsg.payload = {\n    cmd: cmd,\n    source: \"manuel\",                         // pour le journal : un humain a cliqué\n    ts: new Date().toISOString().replace(/\\.\\d{3}Z$/, \"Z\")   // même format que l'ESP32\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1500,
    "y": 980,
    "wires": [["8aa48c3f27cd15fe"]]
  },
  {
