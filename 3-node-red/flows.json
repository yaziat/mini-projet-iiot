  {
    "id": "3070c25ec578a24e",
    "type": "function",
    "z": "93b1832550c85d6a",
    "g": "62b39a21017425e2",
    "name": "Liste des alertes",
    "func": "// Liste des alertes : reçoit les alertes MQTT et l'ordre \"acquitter\", renvoie le tableau\nlet liste = flow.get(\"alertes\") || [];\nlet compteur = flow.get(\"compteurAlertes\") || 0;\n\nif (msg.topic === \"acquitter\") {                         // clic sur le bouton Acquitter\n    liste.forEach(a => { a.acquittee = true; });\n}\nelse if (msg.topic && msg.topic.endsWith(\"/alertes\")) {  // une alerte arrive du broker\n    const p = msg.payload;\n    if (typeof p !== \"object\" || p === null || typeof p.type !== \"string\") {\n        node.warn(\"Alerte ignorée : format invalide\");\n        return null;\n    }\n    compteur++;                                          // Node-RED numérote les alertes\n    liste.push({\n        numero: compteur, type: p.type, grandeur: p.grandeur || \"\",\n        valeur: p.valeur, seuil: p.seuil, ts: p.ts || \"\", acquittee: false\n    });\n    flow.set(\"compteurAlertes\", compteur);\n}\nelse {\n    return null;                                         // états, commandes : pas pour nous\n}\n\nflow.set(\"alertes\", liste);\n\n// Mise en forme pour le tableau du dashboard\nmsg.payload = liste.map(a => ({\n    \"N°\": a.numero,\n    \"Heure (UTC)\": a.ts.replace(\"T\", \" \").replace(\"Z\", \"\"),\n    \"Type\": a.type === \"coupure_locale\" ? \"Coupure locale\" : a.type,\n    \"Grandeur\": a.grandeur,\n    \"Valeur\": a.valeur,\n    \"Seuil\": a.seuil,\n    \"État\": a.acquittee ? \"✔ Acquittée\" : \"⚠ À traiter\"\n}));\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 980,
    "wires": [["b7482c230fe0bf9a"]]
